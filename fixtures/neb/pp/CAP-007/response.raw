{
  "Version": "v1.0",
  "ErrorCodes": {
    "declined_user_consent": {
      "En": "Mandatory user consent was declined."
    },
    "idp_correlation_failure": {
      "En": "User is missing external idp correlation cookie. This can happen, but is not exclusive, on Safari browsers on devices with an incorrect date and time, as Safari uses the local device time for expiration checks of cookies. "
    },
    "idp_no_ctx": {
      "En": "Missing state when validating external IDP response."
    },
    "idp_remote_error": {
      "En": "A technical error occured when user returned from the external idp."
    },
    "internal_error": {
      "En": "An unexpected internal error."
    },
    "invalid_consent_id": {
      "En": "Invalid consent_id in the authorization request."
    },
    "invalid_idp_configuration_or_parameter": {
      "En": "Invalid idp_params parameter or idp configuration for specific flow. This can be a combination of configuration and request parameters."
    },
    "invalid_idp_params": {
      "En": "Invalid idp_params parameter. Typically, invalid encoding of this parameter. For GET requests, these need to be in URL encoded JSON format.For POST request, these need to be in JSON format."
    },
    "invalid_tin": {
      "Da": "Ugyldigt CVR-nummer.",
      "En": "Invalid Tax Identification Number."
    },
    "invalid_user_for_user_consent": {
      "En": "Invalid user for providing the specific user consents."
    },
    "missing_user_consent": {
      "En": "User consent flow does not exist for the user or is expired."
    },
