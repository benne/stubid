      "Da": "En bruger eksisterer ikke i sessionen.",
      "En": "Missing user in session."
    },
    "mitid_anti_forgery_validation_error": {
      "En": "The MitID flow encountered an invalid anti forgery cookie validation. This can happen if the end-user re-visits an earlier page in the flow ex. by clicking back in the browser.",
      "Idp": "mitid"
    },
    "mitid_auth_code_already_used": {
      "En": "The MitID Auth code was already used. This can happen if the browser re-posts the last step of the MitID browser flow and is blocked for security reasons.",
      "Idp": "mitid"
    },
    "mitid_browser_not_supported": {
      "En": "The user browser is not supported by MitID.",
      "Idp": "mitid"
    },
