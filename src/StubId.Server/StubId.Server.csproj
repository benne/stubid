<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Description>The emulated broker surface, and the composition that hosts it.</Description>
    <PackageTags>stubid;mitid;oidc;testing;aspnetcore</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>StubId.Server</RootNamespace>
    <!--
      The Web SDK defaults this to false, because a web application is normally shipped as an
      image rather than as a dependency. This one is both: an in-process host is the same
      composition on a different host, and the only way for that to stay a checkable claim is for
      the module to depend on this assembly rather than carry a copy of it.
    -->
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The controllable clock is a product feature, not a test helper: a timeout that cannot
         be reached is a timeout nobody tests. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../StubId.Wire/StubId.Wire.csproj" />
    <ProjectReference Include="../StubId.Profiles.Abstractions/StubId.Profiles.Abstractions.csproj" />
  </ItemGroup>

  <!--
    The recording is the source of truth for what we serve, so the served template is derived
    from it at build time rather than reproduced by hand. Emitting a document a serialiser
    rebuilt would lose member order and the members the broker leaves out. The recording
    itself is not embedded: the build swaps the broker's host for a placeholder first, so the
    shipped assembly carries no occurrence of it.
  -->
  <UsingTask TaskName="SubstituteInFile" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
      <Find ParameterType="System.String" Required="true" />
      <ReplaceWith ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        // Not WriteLinesToFile: it splits its input on semicolons, which a re-recorded
        // document would silently lose.
        System.IO.File.WriteAllText(
            Destination,
            System.IO.File.ReadAllText(Source).Replace(Find, ReplaceWith),
            new System.Text.UTF8Encoding(false));
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="DeriveDiscoveryTemplate" BeforeTargets="AssignTargetPaths"
          Inputs="../../fixtures/neb/pp/CAP-001/response.raw"
          Outputs="$(IntermediateOutputPath)discovery.template.json">
    <!-- stubid.invalid is reserved by RFC 2606, so nothing resolves it if one ever escapes. -->
    <SubstituteInFile Source="../../fixtures/neb/pp/CAP-001/response.raw"
                      Destination="$(IntermediateOutputPath)discovery.template.json"
                      Find="https://pp.netseidbroker.dk"
                      ReplaceWith="https://stubid.invalid" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)discovery.template.json" LogicalName="discovery.json" />
    </ItemGroup>
  </Target>

  <!-- The root README, so the package page says what this is. Absolute links in it are what
       make that work: nuget.org resolves a relative one against itself. -->
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>


  <ItemGroup>
    <!-- WriteOnceFile is the answer to a race, and the only way to test a race properly is to run
         it thousands of times. Through a caller that generates a certificate each attempt that
         costs ten seconds and still misses; against the primitive it is a fraction of a second and
         does not. Internal rather than public because nothing outside this assembly should be
         writing into the key directory. -->
    <InternalsVisibleTo Include="StubId.Interop.AspNetCore" />
  </ItemGroup>

</Project>
