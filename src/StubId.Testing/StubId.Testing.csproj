<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>A Testcontainers module that runs StubID in Docker for a test suite.</Description>
    <PackageTags>stubid;mitid;oidc;testing;testcontainers;docker</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
      <!-- Held to CS1591: this is one of the four a reader installs, and its members become
         pages in the published API reference. See Directory.Build.props. -->
    <DocumentPublicApi>true</DocumentPublicApi>
</PropertyGroup>

  <ItemGroup>
    <!-- The roots this module composes an authority from are compared against the server's own
         profiles by ModuleProfileTests. That test is what lets the module answer before an
         instance exists without keeping an answer that can go stale unnoticed. -->
    <InternalsVisibleTo Include="StubId.Release.Tests" />
    <!-- And to the module's own tests, for the two paths a container cannot be built to show:
         an image that names no root, and one serving a broker published after this package. -->
    <InternalsVisibleTo Include="StubId.Testing.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The container lifecycle, and nothing else. This is the only reason this package needs a
         Docker daemon; StubId.Client below works against any instance that is already running. -->
    <PackageReference Include="Testcontainers" />
  </ItemGroup>

  <ItemGroup>
    <!-- The module hands back a typed client rather than a base address, so a test never has to
         assemble a control URL by hand. -->
    <ProjectReference Include="../StubId.Client/StubId.Client.csproj" />
  </ItemGroup>

  <!-- The root README, so the package page says what this is. Absolute links in it are what
       make that work: nuget.org resolves a relative one against itself. -->
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
