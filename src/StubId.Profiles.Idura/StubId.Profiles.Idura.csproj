<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Idura's route table. A spike: the routes are real, the login is not implemented.</Description>
    <RootNamespace>StubId.Profiles.Idura</RootNamespace>
    <!-- Not published. Every route but the SDK's configuration probe answers 501, so a package
         would promise a broker it does not emulate. It exists to prove the seam can express a
         second broker, and docs/roadmap.md defers the profile itself past 1.0. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../StubId.Profiles.Abstractions/StubId.Profiles.Abstractions.csproj" />
  </ItemGroup>

</Project>
