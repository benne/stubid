<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- The client library a Danish integrator actually uses. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/StubId.Server/StubId.Server.csproj" />
    <!-- The shipped client, driven against the in-memory server. Every assertion here is one
         the containerised suite does not have to make a second time, on a slower machine. -->
    <ProjectReference Include="../../src/StubId.Client/StubId.Client.csproj" />
    <!-- The OCSP reader, so the response StubID emits is checked by the same decoder that reads
         the broker's rather than by a second one written to agree with the writer.
         Aliased: the harness is an executable, and its top-level Program would otherwise be
         ambiguous with the server's in every WebApplicationFactory<Program> in this project. -->
    <ProjectReference Include="../../tools/StubId.CaptureHarness/StubId.CaptureHarness.csproj"
                      Aliases="harness" />
  </ItemGroup>

</Project>
