bin/
obj/
node_modules/
target/
dist/
*.user
.vs/
.idea/
TestResults/
artifacts/

# Credentials and redaction rules for recording. Plain string replacement, not hashing.
capture.local.json

# The private key whose public half is registered on a broker's client. It is named by a
# setting and belongs outside a checkout; this is the backstop for one written here anyway.
*.pem

# A recording session produces artifacts that carry session cookies, live tokens and the
# test identity's personal number. None of them are scrubbed, and none belong here.
*.har
capture-scratch/

# Local Claude Code session settings.
.claude/settings.local.json

# The manual sitting writes here. Committed deliberately, after review.
!fixtures/neb/pp-session/

# The documentation site, and the API pages docfx writes from the doc comments. The landing page
# beside them is written by hand and is committed; everything else in there is output.
_site/
docs/api/*.yml
docs/api/.manifest
