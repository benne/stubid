<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- One place says what version this is, and everything that names a version is checked
       against it by tests/StubId.Release.Tests. Dated rather than numbered for the reason
       StubIdBuilder.StubIdImage gives: what this emulator changes is bytes, and a fidelity
       correction breaks anyone asserting on the bytes it corrects. Bumped by hand, because
       which recording is being shipped is a decision rather than something a tool can derive
       from the commit graph. NuGet normalizes the leading zero away, so the package version
       reads 2026.9.3 while the container tag stays padded - the padding is what makes the
       tags sort, since 2026.09 precedes 2026.10 and 2026.9 does not. -->
  <PropertyGroup>
    <StubIdVersion>2026.09.3</StubIdVersion>
    <Version>$(StubIdVersion)</Version>
  </PropertyGroup>

  <PropertyGroup>
    <Product>StubID</Product>
    <Authors>StubID contributors</Authors>
    <Copyright>Copyright 2026 StubID contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/benne/stubid</PackageProjectUrl>
    <RepositoryUrl>https://github.com/benne/stubid</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <!-- What a consumer gets besides the assembly. The doc comments in this repository carry the
       reasoning rather than restating the signature, which is worth more in IntelliSense than
       it is in the source alone, and the symbols let someone step into the emulator when a
       fidelity assertion surprises them - which is this project's characteristic failure. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- CS1573 is suppressed everywhere, because a sweep of the param tags is its own change.
       CS1591 is not: it is suppressed by Directory.Build.targets for projects that do not set
       DocumentPublicApi, and the four a reader installs do set it - StubId.Client,
       StubId.Testing, StubId.InProcess and StubId.Abstractions. An undocumented public member in
       those is a build failure, because they are what the published API reference is generated
       from and a blank description there is worse than no page. StubId.Server is deliberately not
       among them: nearly all of its public surface is engine internals that are public only so
       StubId.InProcess can reach them.
       Everything else the switch turns on stays an error: CS1572 caught a param tag naming a
       parameter that does not exist, which had silently dropped a paragraph of reasoning out of
       RouteDeclaration's documentation. Widening this list would have hidden it. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CS1573</NoWarn>
  </PropertyGroup>

  <!-- Normalizes source paths into the package, which only helps where the paths are a build
       server's. Set locally it would make stepping through a local build worse. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
